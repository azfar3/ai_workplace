{
 "autoname": "field:source_name",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "source_name",
  "source_type",
  "file_attachment",
  "content",
  "description",
  "is_active",
  "last_indexed",
  "version_hash",
  "guided_questions",
  "related_intent",
  "target_employment_type",
  "target_department",
  "target_location",
  "effective_from",
  "effective_to",
  "version"
 ],
 "fields": [
  {
   "fieldname": "source_name",
   "fieldtype": "Data",
   "label": "Source Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "source_type",
   "fieldtype": "Select",
   "label": "Source Type",
   "options": "Policy\nSOP\nPortalHelp\nMenuCatalog\nOnboarding\nProfileGuide",
   "in_list_view": 1
  },
  {
   "fieldname": "file_attachment",
   "fieldtype": "Attach",
   "label": "Attach Document (PDF, DOCX, TXT)"
  },
  {
   "fieldname": "content",
   "fieldtype": "Long Text",
   "label": "Content"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "default": "1",
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Is Active"
  },
  {
   "fieldname": "last_indexed",
   "fieldtype": "Datetime",
   "label": "Last Indexed",
   "read_only": 1
  },
  {
   "fieldname": "target_employment_type",
   "fieldtype": "Link",
   "label": "Target Employment Type",
   "options": "Employment Type"
  },
  {
   "fieldname": "target_department",
   "fieldtype": "Link",
   "label": "Target Department",
   "options": "Department"
  },
  {
   "fieldname": "target_location",
   "fieldtype": "Link",
   "label": "Target Location",
   "options": "Location"
  },
  {
   "fieldname": "effective_from",
   "fieldtype": "Date",
   "label": "Effective From"
  },
  {
   "fieldname": "effective_to",
   "fieldtype": "Date",
   "label": "Effective To"
  },
  {
   "fieldname": "version",
   "fieldtype": "Data",
   "label": "Document Version",
   "default": "1.0"
  },
  {
   "fieldname": "version_hash",
   "fieldtype": "Data",
   "label": "Version Hash",
   "read_only": 1
  },
  {
   "fieldname": "guided_questions",
   "fieldtype": "Long Text",
   "label": "Guided Questions",
   "description": "JSON object with English, Urdu and/or Roman Urdu question text. Approved content only."
  },
  {
   "fieldname": "related_intent",
   "fieldtype": "Data",
   "label": "Related Intent",
   "description": "Intent key from the application intent catalog; permissions are checked when selected."
  }
 ],
 "module": "Ai Workplace",
 "name": "AI Workplace Knowledge Source",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ]
}
