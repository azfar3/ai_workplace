{
 "autoname": "format:AIUSE-{YYYY}-{#####}",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "provider",
  "model",
  "channel",
  "employee",
  "status",
  "success",
  "col_break_1",
  "tokens_in",
  "tokens_out",
  "tokens_total",
  "usage_source",
  "latency_ms",
  "col_break_2",
  "input_cost",
  "output_cost",
  "total_cost",
  "currency",
  "retry_count",
  "fallback_used",
  "error_type",
  "request_started_at",
  "request_completed_at",
  "prompt_hash",
  "error_message"
 ],
 "fields": [
  {"fieldname": "provider", "fieldtype": "Link", "label": "Provider", "options": "AI Workplace Provider", "in_list_view": 1},
  {"fieldname": "model", "fieldtype": "Link", "label": "Model", "options": "AI Workplace Model", "in_list_view": 1},
  {"fieldname": "channel", "fieldtype": "Data", "label": "Channel", "in_list_view": 1},
  {"fieldname": "employee", "fieldtype": "Link", "label": "Employee", "options": "Employee"},
  {"default": "Success", "fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Success\nFailed\nTimed Out\nCircuit Open"},
  {"default": "1", "fieldname": "success", "fieldtype": "Check", "label": "Success"},
  {"fieldname": "col_break_1", "fieldtype": "Column Break"},
  {"default": "0", "fieldname": "tokens_in", "fieldtype": "Int", "label": "Tokens In"},
  {"default": "0", "fieldname": "tokens_out", "fieldtype": "Int", "label": "Tokens Out"},
  {"default": "0", "fieldname": "tokens_total", "fieldtype": "Int", "label": "Tokens Total"},
  {"default": "provider_reported", "fieldname": "usage_source", "fieldtype": "Select", "label": "Usage Source", "options": "provider_reported\ntokenizer_estimated"},
  {"fieldname": "latency_ms", "fieldtype": "Int", "label": "Latency (ms)", "in_list_view": 1},
  {"fieldname": "col_break_2", "fieldtype": "Column Break"},
  {"default": "0", "fieldname": "input_cost", "fieldtype": "Currency", "label": "Input Cost"},
  {"default": "0", "fieldname": "output_cost", "fieldtype": "Currency", "label": "Output Cost"},
  {"default": "0", "fieldname": "total_cost", "fieldtype": "Currency", "label": "Total Cost"},
  {"default": "USD", "fieldname": "currency", "fieldtype": "Data", "label": "Currency"},
  {"default": "0", "fieldname": "retry_count", "fieldtype": "Int", "label": "Retry Count"},
  {"fieldname": "fallback_used", "fieldtype": "Data", "label": "Fallback Used"},
  {"fieldname": "error_type", "fieldtype": "Data", "label": "Error Type"},
  {"fieldname": "request_started_at", "fieldtype": "Datetime", "label": "Started At"},
  {"fieldname": "request_completed_at", "fieldtype": "Datetime", "label": "Completed At"},
  {"fieldname": "prompt_hash", "fieldtype": "Data", "label": "Prompt Hash"},
  {"fieldname": "error_message", "fieldtype": "Small Text", "label": "Error Message"}
 ],
 "module": "Ai Workplace",
 "name": "AI Workplace Usage Log",
 "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1}]
}
