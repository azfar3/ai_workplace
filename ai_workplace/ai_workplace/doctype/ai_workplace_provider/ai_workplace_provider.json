  {"fieldname": "section_resilience", "fieldtype": "Section Break", "label": "Timeouts & Retries"},
  {"default": "5", "fieldname": "connect_timeout", "fieldtype": "Int", "label": "Connect Timeout (s)"},
  {"default": "15", "fieldname": "read_timeout", "fieldtype": "Int", "label": "Read Timeout (s)"},
  {"default": "20", "fieldname": "total_timeout", "fieldtype": "Int", "label": "Total Timeout (s)"},
  {"default": "3", "fieldname": "max_retries", "fieldtype": "Int", "label": "Max Retries"},
  {"default": "1.0", "fieldname": "base_delay", "fieldtype": "Float", "label": "Base Retry Delay (s)"},
  {"default": "10.0", "fieldname": "max_delay", "fieldtype": "Float", "label": "Max Retry Delay (s)"},
  {"fieldname": "section_circuit", "fieldtype": "Section Break", "label": "Circuit Breaker"},
